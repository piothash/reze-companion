# =============================================================================
# ARC Trading Authority (VPS) — PRODUCTION environment template
#
# This file belongs to the VPS process (PM2). The VPS is the SOLE trading
# authority: it owns market state, TWAP, decisions, risk and execution.
# NEVER commit real values. Keys below marked [SHARED] must match the companion.
# =============================================================================

# ----------------------------------- Application ----------------------------
NODE_ENV=production                  # required
APP_ENV=production                   # required
PORT=8787                            # required. Port the authority API listens on
HOST=127.0.0.1                       # required. Bind locally; expose via reverse proxy + TLS

# ----------------------------------- Supabase -------------------------------
SUPABASE_URL=                        # [SHARED] required. Same control plane as the companion
SUPABASE_ANON_KEY=                   # [SHARED] required
SUPABASE_PUBLISHABLE_KEY=            # [SHARED] required. Server-side alias of the publishable key
SUPABASE_SERVICE_ROLE_KEY=           # required. Used for authoritative snapshot/ledger writes.
                                     #   Server-only; never leaves the VPS.

# ----------------------------------- Authority ------------------------------
ARC_AUTHORITY_SIGNING_KEY=           # [SHARED] REQUIRED. HMAC-SHA256 key used to sign every
                                     #   message sent to the companion gateway. Must match exactly.
ARC_REQUIRED_SUPABASE_URL=           # [SHARED] required. Guards against pointing at the wrong backend
ARC_AUTHORITY_ID=                    # required. Stable authority identifier in the registry
ARC_COMPANION_BASE_URL=              # required. https URL of the companion control plane
ARC_COMPANION_URL=                   # [SHARED] alias of ARC_COMPANION_BASE_URL; keep both identical
ARC_VPS_API_TOKEN=                   # [SHARED] required. Bearer token the companion presents

# ----------------------------------- Engine ---------------------------------
ENGINE_MODE=OBSERVE                  # required. OBSERVE until activation sign-off, then ARMED
ENGINE_ENVIRONMENT=production        # required
ARC_ENVIRONMENT=production           # [SHARED] required
ARC_NETWORK=mainnet                  # [SHARED] required. testnet | mainnet
ARC_INSTANCE_LABEL=arc-engine-prod   # optional
ARC_PM2_APP_NAME=arc-engine          # required. PM2 process name used for restart detection

# ----------------------------------- Feed (TWAP / PTB / discovery) ----------
ARC_TWAP_PROVIDER=                   # required. Authoritative TWAP provider id
ARC_TWAP_PROVIDER_URL=               # required. Provider endpoint (V1 testnet / V2 mainnet)
ARC_TWAP_WINDOW_SECONDS=60           # required
ARC_FEED_PROVIDER=                   # required. Feed provider label
ARC_FEED_ID=                         # required. Primary feed identifier
ARC_FEED_IDS=                        # required. Comma-separated feed identifiers
ARC_FEED_STALE_AFTER_MS=15000        # optional. Default 15000
ARC_PTB_ENDPOINT=                    # required. Polymarket metadata (PTB) endpoint
ARC_PTB_POLL_MS=2000                 # optional. Default 2000
ARC_CLOB_ENDPOINT=                   # required. Polymarket CLOB endpoint
ARC_DISCOVERY_INTERVAL_MS=30000      # optional. Default 30000
ARC_RPC_URLS=                        # required. Comma-separated RPC endpoints
ARC_API_URLS=                        # required. Comma-separated API endpoints

# ----------------------------------- Scheduler ------------------------------
ARC_SCHEDULER_TICK_MS=1000           # optional. Default 1000
ARC_SCHEDULER_MAX_DRIFT_MS=250       # optional. Default 250
ARC_CLOCK_SKEW_TOLERANCE_MS=2000     # [SHARED] optional. Default 2000

# ----------------------------------- Replay ---------------------------------
ARC_REPLAY_ENABLED=false             # required false on a live authority
ARC_REPLAY_CLOCK_ORIGIN=             # leave empty in production
ARC_EVENT_STORE_PATH=/var/lib/arc/events # required. Durable event store location (never in Git)

# ----------------------------------- Execution profile ----------------------
EXECUTION_PROFILE_ID=                # [SHARED] required. Activated profile identifier
EXECUTION_WINDOWS=15,10,7,5,3        # [SHARED] required. Offsets in seconds
EXECUTION_MODE=SINGLE_TRADE          # [SHARED] required

# ----------------------------------- Notifications --------------------------
ARC_NOTIFICATIONS_ENABLED=true       # optional. Default true
ARC_NOTIFICATION_WEBHOOK_URL=        # optional. Operator alert webhook

# ----------------------------------- Logging --------------------------------
ARC_LOG_LEVEL=info                   # optional. Default info
ARC_LOG_FORMAT=json                  # required json in production
ARC_LOG_DIR=/var/log/arc             # required. PM2 log destination (never in Git)
ARC_METRICS_ENABLED=true             # optional. Default true
ARC_METRICS_NAMESPACE=arc            # optional. Default arc
ARC_HEALTH_TIMEOUT_MS=3000           # optional. Default 3000

# ----------------------------------- Security -------------------------------
ARC_SIGNATURE_MAX_SKEW_MS=30000      # [SHARED] optional. Replay guard window. Default 30000
ARC_RETRY_MAX_ATTEMPTS=3             # optional. Default 3
ARC_RETRY_INITIAL_DELAY_MS=200       # optional. Default 200
ARC_RETRY_MAX_DELAY_MS=5000          # optional. Default 5000
# Wallet / exchange credentials live ONLY in the VPS secret store and are never
# referenced by the companion repository.

# ----------------------------------- Feature flags --------------------------
ARC_FEATURE_STANDING_ORDERS=true     # optional. Default true
ARC_FEATURE_LIVE_TELEMETRY=true      # optional. Default true

# ----------------------------------- Qualification --------------------------
ARC_QUALIFICATION_MODE=mainnet       # optional. testnet until qualification passes
ARC_QUALIFICATION_STRICT=true        # required true — gates fail closed
