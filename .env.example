# =============================================================================
# ARC Companion — example environment (development / local)
#
# Copy to `.env` and fill in. NEVER commit a file containing real values.
# Ownership legend:
#   [COMPANION] read by the control plane (this repository)
#   [VPS]       read by the trading authority process on the VPS
#   [SHARED]    must be identical on both sides
# =============================================================================

# ----------------------------------- Application ----------------------------
NODE_ENV=development                 # [COMPANION] required. development | production
APP_ENV=development                  # [COMPANION] required. Deployment label shown in diagnostics
PORT=8080                            # [COMPANION] optional. Default 8080
HOST=0.0.0.0                         # [COMPANION] optional. Default 0.0.0.0

# ----------------------------------- Supabase -------------------------------
SUPABASE_URL=                        # [SHARED] required. Control-plane database URL
SUPABASE_ANON_KEY=                   # [SHARED] required. Publishable key (safe in browser)
SUPABASE_PUBLISHABLE_KEY=            # [SHARED] required. Server-side alias of the publishable key
SUPABASE_SERVICE_ROLE_KEY=           # [COMPANION] optional locally, required for privileged
                                     #   maintenance paths. SERVER-ONLY. Never exposed to the browser.
VITE_SUPABASE_URL=                   # [COMPANION] required. Browser-visible control-plane URL
VITE_SUPABASE_PUBLISHABLE_KEY=       # [COMPANION] required. Browser-visible publishable key

# ----------------------------------- Authority ------------------------------
ARC_AUTHORITY_SIGNING_KEY=           # [SHARED] required in production. HMAC-SHA256 shared key.
                                     #   Absent => gateway fail-closes (KEY_UNCONFIGURED).
                                     #   Minimum 16 chars, 32+ recommended (openssl rand -hex 32).
ARC_REQUIRED_SUPABASE_URL=           # [SHARED] optional. When set, must equal SUPABASE_URL or the
ARC_AUTHORITY_ID=                    # [SHARED] required in production. Stable authority identifier
ARC_COMPANION_URL=                   # [SHARED] required in production. Public https URL of the companion
                                     #   cutover guard fail-closes.
ARC_VPS_API_TOKEN=                   # [SHARED] optional. Bearer token for companion -> VPS polling
ARC_VPS_TELEMETRY_PATH=/telemetry    # [COMPANION] optional. Default /telemetry
ARC_VPS_TIMEOUT_MS=10000             # [COMPANION] optional. Default 10000

# ----------------------------------- Engine ---------------------------------
ENGINE_MODE=OBSERVE                  # [VPS] optional. OBSERVE | ARMED | DISABLED. Default OBSERVE
ENGINE_ENVIRONMENT=development       # [VPS] optional. development | staging | production
ARC_ENVIRONMENT=development          # [SHARED] required. Runtime environment
ARC_NETWORK=testnet                  # [SHARED] required. testnet | mainnet
ARC_INSTANCE_LABEL=arc-companion     # [COMPANION] optional. Default arc-companion
ARC_ENGINE_BASE_URL=                 # [COMPANION] required on mainnet. VPS authority base URL
ARC_ENGINE_TIMEOUT_MS=10000          # [COMPANION] optional. Default 10000
ARC_ENGINE_FRESHNESS_MS=30000        # [COMPANION] optional. Default 30000

# ----------------------------------- Feed (TWAP / PTB / discovery) ----------
ARC_TWAP_PROVIDER=chainlink-v1       # [VPS] required. Authoritative TWAP provider id
ARC_TWAP_PROVIDER_URL=               # [VPS] optional. Provider endpoint
ARC_TWAP_WINDOW_SECONDS=60           # [VPS] required. Sliding window length
ARC_FEED_PROVIDER=chainlink          # [VPS] optional. Feed provider label surfaced in telemetry
ARC_FEED_ID=                         # [VPS] optional. Primary feed identifier
ARC_FEED_IDS=                        # [VPS] required. Comma-separated feed identifiers
ARC_FEED_STALE_AFTER_MS=15000        # [VPS] optional. Default 15000
ARC_RPC_URLS=                        # [VPS] optional. Comma-separated RPC endpoints (discovery)
ARC_API_URLS=                        # [VPS] optional. Comma-separated API endpoints (discovery)

# ----------------------------------- Scheduler ------------------------------
ARC_SCHEDULER_TICK_MS=1000           # [VPS] optional. Default 1000
ARC_SCHEDULER_MAX_DRIFT_MS=250       # [VPS] optional. Default 250
ARC_CLOCK_SKEW_TOLERANCE_MS=2000     # [SHARED] optional. Default 2000

# ----------------------------------- Replay ---------------------------------
ARC_REPLAY_ENABLED=false             # [COMPANION] optional. Default false
ARC_REPLAY_CLOCK_ORIGIN=             # [COMPANION] optional. ISO-8601 deterministic clock origin

# ----------------------------------- Execution profile ---------------------
EXECUTION_PROFILE_ID=default         # [SHARED] required. Active execution profile identifier
EXECUTION_WINDOWS=15,10,7,5,3        # [SHARED] required. Window offsets in seconds — never hardcoded
EXECUTION_MODE=SINGLE_TRADE          # [SHARED] required. SINGLE_TRADE | MULTI_TRADE

# ----------------------------------- Notifications --------------------------
ARC_NOTIFICATIONS_ENABLED=true       # [COMPANION] optional. Default true
ARC_NOTIFICATION_WEBHOOK_URL=        # [COMPANION] optional. Operator alert webhook

# ----------------------------------- Dashboard ------------------------------
ARC_DASHBOARD_REFRESH_MS=5000        # [COMPANION] optional. Default 5000
ARC_DEPLOYED_AT=                     # [COMPANION] optional. ISO-8601 deploy timestamp (diagnostics)
ARC_GIT_COMMIT=                      # [COMPANION] optional. Release commit shown in diagnostics

# ----------------------------------- Logging --------------------------------
ARC_LOG_LEVEL=info                   # [SHARED] optional. Default info
ARC_LOG_FORMAT=pretty                # [SHARED] optional. json is mandatory in production
ARC_METRICS_ENABLED=true             # [SHARED] optional. Default true
ARC_METRICS_NAMESPACE=arc            # [SHARED] optional. Default arc
ARC_HEALTH_TIMEOUT_MS=3000           # [SHARED] optional. Default 3000

# ----------------------------------- Security -------------------------------
ARC_SIGNATURE_MAX_SKEW_MS=30000      # [SHARED] optional. Replay guard window. Default 30000
ARC_RETRY_MAX_ATTEMPTS=3             # [SHARED] optional. Default 3
ARC_RETRY_INITIAL_DELAY_MS=200       # [SHARED] optional. Default 200
ARC_RETRY_MAX_DELAY_MS=5000          # [SHARED] optional. Default 5000

# ----------------------------------- Feature flags --------------------------
ARC_FEATURE_LIVE_TELEMETRY=true      # [COMPANION] optional. Default true
ARC_FEATURE_QUALIFICATION_CONSOLE=true # [COMPANION] optional. Default true

# ----------------------------------- Qualification --------------------------
ARC_QUALIFICATION_MODE=testnet       # [COMPANION] optional. testnet | mainnet
ARC_QUALIFICATION_STRICT=true        # [COMPANION] optional. Default true — gates fail closed
