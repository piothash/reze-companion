# =============================================================================
# ARC Companion — PRODUCTION environment template (control plane)
#
# Copy to the hosting provider's secret store. NEVER commit real values.
# Ownership legend: [COMPANION] control plane · [VPS] trading authority · [SHARED] both
# =============================================================================

# ----------------------------------- Application ----------------------------
NODE_ENV=production                  # required
APP_ENV=production                   # required. Deployment label shown in diagnostics
PORT=8080                            # optional. Default 8080
HOST=0.0.0.0                         # optional. Default 0.0.0.0

# ----------------------------------- Supabase -------------------------------
SUPABASE_URL=                        # [SHARED] required. Production control-plane URL
SUPABASE_ANON_KEY=                   # [SHARED] required. Publishable key
SUPABASE_PUBLISHABLE_KEY=            # [SHARED] required. Server-side alias of the publishable key
SUPABASE_SERVICE_ROLE_KEY=           # [COMPANION] required. SERVER-ONLY privileged key.
                                     #   Never bundled, never logged, never returned to the browser.
VITE_SUPABASE_URL=                   # [COMPANION] required. Browser-visible control-plane URL
VITE_SUPABASE_PUBLISHABLE_KEY=       # [COMPANION] required. Browser-visible publishable key

# ----------------------------------- Authority ------------------------------
ARC_AUTHORITY_SIGNING_KEY=           # [SHARED] REQUIRED in production. Must match the VPS value
                                     #   exactly. 32+ chars. Absent => every authority message is
                                     #   rejected (fail-closed).
ARC_REQUIRED_SUPABASE_URL=           # [SHARED] required. Must equal SUPABASE_URL; a mismatch
ARC_AUTHORITY_ID=                    # [SHARED] required in production. Stable authority identifier
ARC_COMPANION_URL=                   # [SHARED] required in production. Public https URL of the companion
                                     #   fail-closes the production cutover guard.
ARC_VPS_API_TOKEN=                   # [SHARED] required. Bearer token for companion -> VPS reads
ARC_VPS_TELEMETRY_PATH=/telemetry    # optional. Default /telemetry
ARC_VPS_TIMEOUT_MS=10000             # optional. Default 10000

# ----------------------------------- Engine ---------------------------------
ENGINE_MODE=OBSERVE                  # [VPS] set ARMED only after activation sign-off
ENGINE_ENVIRONMENT=production        # [VPS] required
ARC_ENVIRONMENT=production           # [SHARED] required
ARC_NETWORK=mainnet                  # [SHARED] required. testnet | mainnet
ARC_INSTANCE_LABEL=arc-companion-prod # optional
ARC_ENGINE_BASE_URL=                 # [COMPANION] required on mainnet. https URL of the VPS authority
ARC_ENGINE_TIMEOUT_MS=10000          # optional. Default 10000
ARC_ENGINE_FRESHNESS_MS=30000        # optional. Default 30000

# ----------------------------------- Feed (mirrored, read-only) -------------
ARC_TWAP_PROVIDER=                   # [VPS] required. Authoritative TWAP provider id
ARC_TWAP_PROVIDER_URL=               # [VPS] required in production
ARC_TWAP_WINDOW_SECONDS=60           # [VPS] required
ARC_FEED_PROVIDER=                   # [VPS] optional. Provider label in telemetry
ARC_FEED_ID=                         # [VPS] optional. Primary feed id
ARC_FEED_IDS=                        # [VPS] required. Comma-separated feed ids
ARC_FEED_STALE_AFTER_MS=15000        # [VPS] optional. Default 15000
ARC_RPC_URLS=                        # [VPS] required in production. Discovery RPC endpoints
ARC_API_URLS=                        # [VPS] required in production. Discovery API endpoints

# ----------------------------------- Scheduler ------------------------------
ARC_SCHEDULER_TICK_MS=1000           # [VPS] optional. Default 1000
ARC_SCHEDULER_MAX_DRIFT_MS=250       # [VPS] optional. Default 250
ARC_CLOCK_SKEW_TOLERANCE_MS=2000     # [SHARED] optional. Default 2000

# ----------------------------------- Replay ---------------------------------
ARC_REPLAY_ENABLED=false             # required false in production
ARC_REPLAY_CLOCK_ORIGIN=             # leave empty in production

# ----------------------------------- Execution profile ----------------------
EXECUTION_PROFILE_ID=                # [SHARED] required. Published profile identifier
EXECUTION_WINDOWS=15,10,7,5,3        # [SHARED] required. Offsets in seconds
EXECUTION_MODE=SINGLE_TRADE          # [SHARED] required

# ----------------------------------- Notifications --------------------------
ARC_NOTIFICATIONS_ENABLED=true       # optional. Default true
ARC_NOTIFICATION_WEBHOOK_URL=        # optional. Operator alert webhook

# ----------------------------------- Dashboard ------------------------------
ARC_DASHBOARD_REFRESH_MS=5000        # optional. Default 5000
ARC_DEPLOYED_AT=                     # optional. ISO-8601 deploy timestamp
ARC_GIT_COMMIT=                      # optional. Release commit hash shown in diagnostics

# ----------------------------------- Logging --------------------------------
ARC_LOG_LEVEL=info                   # optional. Default info
ARC_LOG_FORMAT=json                  # required json in production
ARC_METRICS_ENABLED=true             # optional. Default true
ARC_METRICS_NAMESPACE=arc            # optional. Default arc
ARC_HEALTH_TIMEOUT_MS=3000           # optional. Default 3000

# ----------------------------------- Security -------------------------------
ARC_SIGNATURE_MAX_SKEW_MS=30000      # [SHARED] optional. Replay guard window. Default 30000
ARC_RETRY_MAX_ATTEMPTS=3             # optional. Default 3
ARC_RETRY_INITIAL_DELAY_MS=200       # optional. Default 200
ARC_RETRY_MAX_DELAY_MS=5000          # optional. Default 5000

# ----------------------------------- Feature flags --------------------------
ARC_FEATURE_LIVE_TELEMETRY=true      # optional. Default true
ARC_FEATURE_QUALIFICATION_CONSOLE=true # optional. Default true

# ----------------------------------- Qualification --------------------------
ARC_QUALIFICATION_MODE=mainnet       # optional. Must be mainnet before activation
ARC_QUALIFICATION_STRICT=true        # required true in production — gates fail closed
